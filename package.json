{
  "name": "videojuke",
  "version": "1.0.0",
  "description": "A random video player with queue management and smooth transitions",
  "main": "dist/server/electron/main.js",
  "author": "",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "build": "node scripts/build.mjs",
    "clean": "node scripts/clean.mjs",
    "typecheck": "tsc -b tsconfig.json",
    "test": "node scripts/test.mjs",
    "start": "npm run electron",
    "electron": "npm run build && electron dist/server/electron/main.js",
    "web": "npm run build && node dist/server/web/main.js",
    "dev:electron": "npm run build && electron dist/server/electron/main.js --dev",
    "dev:web": "npm run build && node dist/server/web/main.js --dev",
    "package:electron": "npm run build && electron-builder",
    "package:webos": "node scripts/package-webos.mjs",
    "archive": "npm run build && node dist/server/archive/main.js",
    "setup": "node scripts/setup.mjs",
    "setup:remove": "node scripts/setup-remove.mjs",
    "launch": "node scripts/launch.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/ffprobe-static": "^2.0.3",
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/node": "^22.15.3",
    "@types/ws": "^8.5.13",
    "electron": "^36.3.2",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.3"
  },
  "build": {
    "appId": "com.videojuke.player",
    "productName": "VideoJuke",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "config.default.json",
      "package.json",
      "!**/*.map"
    ],
    "mac": {
      "category": "public.app-category.video"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
